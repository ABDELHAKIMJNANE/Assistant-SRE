# ═══════════════════════════════════════════════
# Backend FastAPI AIOps — Variables d'Environnement
# Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════

# MongoDB (local) / Cosmos DB (AKS)
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=aiops_db

# Azure OpenAI
OPENAI_ENDPOINT=https://openai-sre-xxx.openai.azure.com/
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_DEPLOYMENT=gpt-35-turbo
OPENAI_API_VERSION=2024-02-01

# Observabilité
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090

# Notification Email
# --- Développement local (MailHog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Assistant SRE
SRE_EMAIL=sre-team@example.com
# --- Production (Outlook) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-email-password
# SRE_EMAIL=sre-team@company.com

# Logging
LOG_LEVEL=INFO
